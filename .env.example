# API key the other team must send as: X-API-Key: <value>
API_KEY=change-me

# Existing Ollama container (already running on the host, GPU 1)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_CLASSIFY_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=all-minilm
EMBED_DIM=384
# qwen3 thinking mode: off by default for faster, direct RAG answers
OLLAMA_THINK=false

# Text generation server: "ollama" (uses OLLAMA_BASE_URL / OLLAMA_MODEL above) or "openai"
# (any OpenAI-compatible server, e.g. vLLM). Embeddings always use Ollama.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://118.67.212.45:8000/v1
LLM_MODEL=gemma4
LLM_API_KEY=
# Set true only when LLM_MODEL reads images (gemma4 does); chat requests may then attach one.
LLM_IMAGE_INPUT=false
# Set true only when LLM_MODEL hears audio (gemma4 on vLLM does; Ollama never).
LLM_AUDIO_INPUT=false

# Qdrant (spun up by docker-compose, internal network only)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents

# Chunking
CHUNK_SIZE=480
CHUNK_OVERLAP=60

# Retrieval
DEFAULT_TOP_K=5
MAX_TOP_K=20
MIN_RELEVANCE_SCORE=0.3

# Upload limits
MAX_UPLOAD_MB=25

# CORS: comma-separated origins, or * for any
ALLOWED_ORIGINS=*

# Main Polygon Bank platform (Kong gateway) — source of the live banking taxonomy
# (support/v1/services, support/v1/pay-transfer) and the real adapter endpoints
# (transfer/, polygon-bank/, auth/). Set to your environment's real base URL.
PLATFORM_API_BASE_URL=https://change-me.example.com
TAXONOMY_REFRESH_SECONDS=900

# Dev/test only: platform test account the demo portal logs in with (server-side; the
# password is never sent to the browser). Leave empty in production.
DEMO_LOGIN_USERNAME=
DEMO_LOGIN_PASSWORD=
# Dev/test only: the demo portal fills in API_KEY by itself (GET /demo-config). Anyone who
# can reach the server gets the key -- leave this false unless the port is bound to 127.0.0.1 (docker-compose.yml).
DEMO_PORTAL_AUTOFILL_API_KEY=false
